{
  "manifest_version": 3,
  "name": "Yomitan Copilot Companion",
  "version": "0.1.0",
  "description": "AI-powered grammar analysis companion for Yomitan. Get full sentence breakdowns, grammar explanations, and contextual understanding alongside Yomitan's dictionary lookups.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://models.github.ai/*",
    "https://api.anthropic.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
